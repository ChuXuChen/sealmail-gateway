# ops/gateway-stack-up.sh creates .env.gateway from this template and fills the
# secret placeholders automatically. Use the same compose file on both servers;
# only these values differ.

SEALMAIL_SITE=alpha
SEALMAIL_DEPLOYMENT_MODE=debug
SPRING_PROFILES_ACTIVE=postgres

# Domains for this node and the peer node.
LOCAL_DOMAIN=alpha.sealmail.top
REMOTE_DOMAIN=beta.sealmail.top

# Public hostnames are optional while DNS is pending. Use public IPs first.
POSTFIX_HOSTNAME=mx-alpha.sealmail.top
REMOTE_STANDARD_HOST=
REMOTE_STANDARD_PORT=2527

# standard = Postfix STARTTLS route to REMOTE_STANDARD_HOST:REMOTE_STANDARD_PORT
# gm = Postfix routes REMOTE_DOMAIN through local SealMail Edge outbound.
# none = only accept local-domain mail and do not add a remote transport.
REMOTE_ROUTE_MODE=standard

# Local delivery defaults to Mailpit in debug mode. In production use smtp and
# point LOCAL_DELIVERY_HOST/PORT at your downstream mailbox service, or use none
# to reject post-filter local-domain delivery explicitly.
LOCAL_DELIVERY_MODE=mailpit
LOCAL_DELIVERY_HOST=
LOCAL_DELIVERY_PORT=
LOCAL_DELIVERY_TRANSPORT=smtp-clear

# Edge outbound route format matches sealmail-edge.properties:
#   beta.sealmail.top=<peer-public-ip-or-hostname>:2525
#   beta.sealmail.top=IMPLICIT_TLS://<peer-public-ip-or-hostname>:2465
EDGE_OUTBOUND_ROUTES=

SEALMAIL_DB_NAME=sealmail
SEALMAIL_DB_USERNAME=sealmail
SEALMAIL_DB_PASSWORD=replace-with-db-password

# Published only when SEALMAIL_DEPLOYMENT_MODE=debug.
SEALMAIL_DB_HOST_PORT=5433

SEALMAIL_JWT_SECRET=replace-with-at-least-32-bytes-random-secret
SEALMAIL_JWT_TOKEN_VALIDITY_SECONDS=3600
# Keep both local tunnel ports allowed so one workstation can administer two
# gateway nodes at the same time:
#   alpha frontend: http://localhost:8088
#   beta frontend:  http://localhost:8089
SEALMAIL_CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:8089,http://127.0.0.1:8089
SEALMAIL_CA_CRL_BASE_URL=http://localhost:8080/api/v1/crl/
SEALMAIL_KEYSTORE_PASSWORD=replace-with-strong-keystore-password
SEALMAIL_RAW_CONTENT_ENCRYPTION_KEY=replace-with-32-byte-random-raw-mail-key

SEALMAIL_ADMIN_USER_ID=admin-alpha
SEALMAIL_ADMIN_USERNAME=admin
SEALMAIL_ADMIN_EMAIL=admin@alpha.sealmail.top
SEALMAIL_ADMIN_PASSWORD=replace-with-admin-password

SEALMAIL_FRONTEND_BIND=127.0.0.1
SEALMAIL_FRONTEND_HTTP_PORT=8088
SEALMAIL_HTTPS_ENABLED=false
SEALMAIL_PUBLIC_HOST=
SEALMAIL_HTTPS_HTTP_PORT=80
SEALMAIL_HTTPS_HTTPS_PORT=443
SEALMAIL_JAVA_TOOL_OPTIONS=-Xms256m -Xmx1024m

# Published only when SEALMAIL_DEPLOYMENT_MODE=debug.
SEALMAIL_BACKEND_HTTP_PORT=8080
SEALMAIL_SMTP_DEBUG_PORT=10025

# Standard SMTP STARTTLS/implicit TLS relay verification used by backend direct
# delivery routes. Keep strict verification in production. For a two-node lab
# with self-signed Postfix TLS certs, set trust-all=true only temporarily.
SEALMAIL_STANDARD_TLS_VERIFY_PEER_CERTIFICATE=true
SEALMAIL_STANDARD_TLS_TRUST_ALL=false
SEALMAIL_STANDARD_TLS_TRUST_STORE_PATH=
SEALMAIL_STANDARD_TLS_TRUST_STORE_PASSWORD=
SEALMAIL_STANDARD_TLS_TRUST_STORE_TYPE=PKCS12

# This exposes container Postfix port 25 as a high public lab ingress port.
# It is not an RFC submission service and does not enable SMTP AUTH/SASL.
POSTFIX_PUBLIC_SMTP_PORT=2527
POSTFIX_SMTPD_TLS_SECURITY_LEVEL=may
POSTFIX_REMOTE_TLS_SECURITY_LEVEL=encrypt

# Standard route TLS policy. The default encrypts transport but does not verify
# peer identity. For production use secure with a private/public CA, or
# fingerprint with a pinned peer certificate fingerprint.
POSTFIX_REMOTE_TLS_CA_FILE=
POSTFIX_REMOTE_TLS_FINGERPRINT_DIGEST=sha256
POSTFIX_REMOTE_TLS_POLICY_LEVEL=
POSTFIX_REMOTE_TLS_POLICY_MATCH=
POSTFIX_REMOTE_TLS_POLICY_FINGERPRINT=
POSTFIX_REMOTE_TLS_POLICY_PROTOCOLS=
POSTFIX_REMOTE_TLS_POLICY_CIPHERS=

# Blank means debug mode publishes REMOTE_DOMAIN as an accepted relay domain for
# two-node tests, while production mode limits public ingress to LOCAL_DOMAIN.
POSTFIX_PUBLIC_RELAY_REMOTE_DOMAIN=
POSTFIX_EXTRA_MYNETWORKS=

EDGE_STARTTLS_PUBLIC_PORT=2525
EDGE_IMPLICIT_TLS_PUBLIC_PORT=2465
SEALMAIL_GM_EDGE_PUBLIC_ENABLED=false
SEALMAIL_GM_EDGE_OUTBOUND_HOST=sealmail-edge
SEALMAIL_GM_EDGE_OUTBOUND_PORT=2526
EDGE_JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m

# Published only when SEALMAIL_DEPLOYMENT_MODE=debug.
EDGE_ADMIN_HOST_PORT=2727

# Mount files under runtime/<site>/edge-secrets and then set these paths.
# Leave blank until GM/TLCP keystores are ready.
EDGE_TLS_KEY_STORE=
EDGE_TLS_KEY_STORE_PASSWORD=
EDGE_TLS_TRUST_STORE=
EDGE_TLS_TRUST_STORE_PASSWORD=
EDGE_TLS_TRUST_ALL=false

# These ports are published only when SEALMAIL_DEPLOYMENT_MODE=debug.
# When tunneling two nodes from one workstation, use local port 8025 for alpha
# and local port 8026 for beta; the server-side Mailpit port can remain 8025.
MAILPIT_SMTP_DEBUG_PORT=1025
MAILPIT_UI_HOST_PORT=8025
