# Docker Compose local defaults. Copy values into your local .env and replace
# every password/secret value before running.

SEALMAIL_DB_NAME=sealmail
SEALMAIL_DB_USERNAME=sealmail
SEALMAIL_DB_PASSWORD=change-me-local-db-password
SEALMAIL_DB_HOST_PORT=5433

SEALMAIL_BACKEND_HTTP_PORT=8080
SEALMAIL_SMTP_PORT=10025
SEALMAIL_UID=1000
SEALMAIL_GID=1000

SEALMAIL_JWT_SECRET=replace-with-at-least-32-bytes-random-secret
SEALMAIL_KEYSTORE_PASSWORD=replace-with-strong-local-keystore-password

SEALMAIL_INIT_CERTS_ENABLED=true
