# Docker Compose local defaults. ops/local-stack-up.sh copies this file to .env
# and fills password/secret placeholders automatically.

SEALMAIL_DB_NAME=sealmail
SEALMAIL_DB_USERNAME=sealmail
SEALMAIL_DB_PASSWORD=change-me-local-db-password
SEALMAIL_DB_HOST_PORT=5433

SEALMAIL_BACKEND_HTTP_PORT=8080
SEALMAIL_SMTP_PORT=10025
SEALMAIL_UID=1000
SEALMAIL_GID=1000
SPRING_PROFILES_ACTIVE=postgres

SEALMAIL_JWT_SECRET=replace-with-at-least-32-bytes-random-secret
SEALMAIL_JWT_TOKEN_VALIDITY_SECONDS=3600
SEALMAIL_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEALMAIL_KEYSTORE_PASSWORD=replace-with-strong-local-keystore-password
SEALMAIL_RAW_CONTENT_ENCRYPTION_KEY=replace-with-32-byte-random-raw-mail-key

SEALMAIL_INIT_CERTS_ENABLED=true
